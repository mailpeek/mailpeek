{
  "name": "mailpeek",
  "private": true,
  "scripts": {
    "build": "pnpm -r --filter '!mailpeek-sandbox' build",
    "test": "pnpm -r test",
    "lint": "eslint packages --ext .ts,.vue",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "build:all": "pnpm build && pnpm docs:build",
    "send-test": "node scripts/send-test.mjs",
    "pack:templates": "cd packages/templates && npm pack",
    "generate-thumbnails": "node scripts/generate-thumbnails.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "minimatch": "^9.0.7",
      "rollup": "^4.59.0",
      "esbuild": "^0.25.0",
      "ajv": "^6.14.0"
    }
  },
  "devDependencies": {
    "@mailpeek/components": "workspace:*",
    "@mailpeek/preview": "workspace:*",
    "@mailpeek/templates": "workspace:*",
    "dotenv": "^16.0.0",
    "playwright": "^1.40.0",
    "resend": "^4.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.50.0",
    "eslint-plugin-vue": "^9.17.0",
    "typescript": "^5.2.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.0"
  }
}
